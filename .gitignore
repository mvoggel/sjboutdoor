# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# internal pricing source tables — reference material for the client-side
# estimator. NEVER commit: repo is public and these hold raw/internal pricing.
/pricing-source/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# visualizer pipeline — large/licensed assets stay local
/visualizer-pipeline/*.blend
/visualizer-pipeline/*.blend1
/visualizer-pipeline/textures/
/visualizer-pipeline/hdri/
/visualizer-pipeline/backplate.*

# blender experiments — keep .blend files and intermediate PNG sequences local
/blender-experiments/**/*.blend
/blender-experiments/**/*.blend1
/blender-experiments/**/renders/
/public/experiments/shade-reveal/shade-close.webm

# Internal infrastructure/deployment reference — may hold credentials
# (dashboard logins, API keys, DNS/registrar notes). Keep local only.
/DEPLOYMENT.md

# All site videos are served from Cloudflare R2 (object storage), not bundled
# into the deploy — Cloudflare Pages rejects any file over 25 MiB and the
# background videos far exceed that. The files stay here on disk for local dev
# (mediaSrc() in lib/media-src.ts falls back to serving them from /video when
# NEXT_PUBLIC_MEDIA_BASE is unset); in production mediaSrc points at the R2 URL.
# Upload the contents of this folder to the R2 bucket under a `video/` prefix.
/public/video/
