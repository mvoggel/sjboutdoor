# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# internal pricing source tables — reference material for the client-side
# estimator. NEVER commit: repo is public and these hold raw/internal pricing.
/pricing-source/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# visualizer pipeline — large/licensed assets stay local
/visualizer-pipeline/*.blend
/visualizer-pipeline/*.blend1
/visualizer-pipeline/textures/
/visualizer-pipeline/hdri/
/visualizer-pipeline/backplate.*

# blender experiments — keep .blend files and intermediate PNG sequences local
/blender-experiments/**/*.blend
/blender-experiments/**/*.blend1
/blender-experiments/**/renders/
/public/experiments/shade-reveal/shade-close.webm

# raw/working video sources — kept local (not referenced by the site; optimized
# versions are what's served). Two exceed GitHub's 100MB limit.
/public/video/part1loop.MP4
/public/video/part2loop.MOV
/public/video/shadesvid.mov
/public/video/shadesvid2.MOV
